<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- memors-tray.app. @SHORT_VERSION@ is filled in by scripts/build-app.sh. -->
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>memors-tray</string>
	<key>CFBundleDisplayName</key>
	<string>memors-tray</string>
	<key>CFBundleIdentifier</key>
	<string>io.github.kkeo.memors-tray</string>
	<key>CFBundleExecutable</key>
	<string>memors-tray</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>@SHORT_VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@SHORT_VERSION@</string>
	<!-- The oldest macOS Go 1.26 supports. -->
	<key>LSMinimumSystemVersion</key>
	<string>12.0</string>
	<!-- A menu-bar app: no Dock icon, no app menu. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>MIT License · github.com/kKEo/memors</string>
	<!-- Stats windows load memors-mcp's pages over plain HTTP on loopback. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
