# Built binary. Anchored to the repo root — an unanchored "memo-mcp" would
# also match cmd/memo-mcp/, silently ignoring any new file added there.
/memo-mcp

# Local databases and coverage output that shouldn't be checked in.
*.db
*.db-wal
*.db-shm
coverage.out

# ...except checked-in test fixture databases, which are deliberately
# tracked (see internal/journal/migrate_test.go).
!internal/**/testdata/*.db

# Editor and OS artefacts.
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Release artefacts (GoReleaser).
/dist/

# Built documentation (make docs).
/site/

# memo-tray (tray/, its own Go module): binary and app bundle builds.
/tray/memo-tray
/tray/dist/

# A go.work would pull the cgo tray module into the root ./... patterns.
go.work
go.work.sum
